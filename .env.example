# Sunshine Restaurant - Server-Side Environment Variables Template
# NEVER commit real passwords, secret tokens, or private keys to version control.
# In Netlify, configure these under: Site Settings -> Environment Variables.

# HMAC Session Token Signing Secret (32+ random characters)
SESSION_SECRET=your_cryptographically_secure_random_session_secret_here

# Super Administrator (Server-Only, never prefixed with VITE_)
SUPER_ADMIN_EMAIL=nagaaswith7@gmail.com
SUPER_ADMIN_PASSWORD_HASH=your_pbkdf2_sha512_password_hash_here
SUPER_ADMIN_SALT=your_16_byte_hex_salt_here

# Standard Administrator (Server-Only, never prefixed with VITE_)
STANDARD_ADMIN_EMAIL=admin@sunshine.com
STANDARD_ADMIN_PASSWORD_HASH=your_standard_admin_hash_here
STANDARD_ADMIN_SALT=your_standard_admin_salt_here

